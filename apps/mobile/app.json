{
  "expo": {
    "//": "Placeholder identity: 'Yada' is not yet trademark-cleared (PRD 0E). studio.yada.reader and the display name are John's working choices; revisit both before any App Store submission.",
    "name": "Yada",
    "slug": "yada",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "yada",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "studio.yada.reader",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/brand/icon.png",
        "dark": "./assets/brand/icon-dark.png",
        "tinted": "./assets/brand/icon-tinted.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-symbol-dark.png",
          "imageWidth": 125,
          "resizeMode": "contain",
          "backgroundColor": "#0E1814"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
